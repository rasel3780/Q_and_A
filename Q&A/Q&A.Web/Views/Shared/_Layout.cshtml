<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Q_A.Web</title>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Q_A.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <script src="~/js/jquery-3.7.1.js"></script>

    <script src="~/js/Service/QuestionService.js"></script>
    <script src="~/js/Service/AnswerService.js"></script>
    <script src="~/js/Service/UserService.js"></script>
    <script src="~/js/Controller/QuestionController.js"></script>
    <script src="~/js/Controller/AnswerController.js"></script>
    <script src="~/js/Controller/UserController.js"></script>


    <style>
        #loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.7);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            display: none;
        }
    </style>

</head>
<body>
    <div id="loading-overlay">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3 fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/logo.png" alt="Logo" height="30"  class="d-inline-block align-top mr-2">
              
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1" style="font-weight:bold;">
                        <li class="nav-item mx-2">
                            <a class="nav-link" asp-area="" asp-controller="Question" asp-action="Index" >Questions</a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link" id="askBtn" href="#" onclick="checkAuthorizationAndRedirect()">Ask Question</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav d-flex">
                        <li id="navLogin" class="nav-item mx-2">
                            <a class="btn btn-primary " onclick="window.location.href='@Url.Action("Login","User")'">Login</a>
                        </li>
                        <li id="navUser" class="nav-item mx-2" style="display: none;">
                            <a id="navUserName" class="nav-link " style="cursor: pointer;" onclick="window.location.href='@Url.Action("Profile","User")'"><i class="bi bi-person-circle"></i> <span></span></a>

                        </li>
                        <li id="navLogout" class="nav-item" style="display: none;">
                            <a class="btn btn-danger" href="#" id="logoutButton">Logout</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav> 


    </header>
    <div class="container main-container mt-5">
        
        <main role="main" class="pb-3" >
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-2 bg-light">
        <div class="container d-flex justify-content-center align-items-center h-100">
            <span class="text-muted">&copy; 2024 - Develop by Rasel Kibria</span>
        </div>
    </footer>


    <script>
        function showLoading() {
            document.getElementById('loading-overlay').style.display = 'flex';
        }

        function hideLoading() {
            document.getElementById('loading-overlay').style.display = 'none';
        }

        // Automatically show loading on page load
        showLoading();

        // Hide loading when the page is fully loaded
        window.addEventListener('load', hideLoading);

        // Intercept AJAX requests to show/hide loading
        $(document).ajaxStart(showLoading);
        $(document).ajaxStop(hideLoading);
    </script>
    <script>
        var NotificationHelper = {
            showSuccess: function (message, callback) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: message,
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    if (callback) callback();
                });
            },
            showError: function (message) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: message
                });
            }
        };
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
   
    

    <script>
        function checkAuthorizationAndRedirect() {
            var token = localStorage.getItem('token');
            if (token) {
                window.location.href = '@Url.Action("AskQuestion", "Question")';
            } else {
                window.location.href = '@Url.Action("Login", "User")?redirectTo=askQuestion';
            }
        }
        $(document).ready(function () {
            console.log("hit");
            const userName = localStorage.getItem('userName');
            var token = localStorage.getItem('token');
            if (userName) {
             
                $('#navLogin').hide();
                $('#navUserName span').text(userName);
                $('#navUser').show();
                $('#navLogout').show();
            } else {
            
                $('#navLogin').show();
                $('#navUser').hide();
                $('#navLogout').hide();
            }

            $('#logoutButton').click(function () {
                localStorage.removeItem('userID');
                localStorage.removeItem('userName');
                localStorage.removeItem('token');
                window.location.href = '/';
            });
            $('#navUserName').click(function (e) {
                e.preventDefault();
                
            });

            $('#askBtn').click(function (e) {
                e.preventDefault();
                checkAuthorizationAndRedirect();
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
