<!DOCTYPE html>
<html>
<head>
    <title>Ask a Question</title>
    <link rel="stylesheet" type="text/css" href="path/to/your/css/file.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  
    <style>
        .form-group {
            margin-bottom: 1.5em;
        }
        .category-group {
            display: flex;
            align-items: center;
        }
        .category-group select,
        .category-group input,
        .category-group button {
            margin-right: 10px;
            flex: 1;
        }
        .category-group button {
            flex: 0 0 auto;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Ask a Question</h2>
        <form id="askQuestionForm" onsubmit="QuestionController.PostQuestion(); return false;">
            <div class="form-group">
                <label for="title">Title <span class="text-danger">*</span></label>
                <input type="text" id="title" class="form-control" placeholder="Enter the title of your question" required>
            </div>
            <div class="form-group">
                <label for="questionText">Your Question <span class="text-danger">*</span></label>
                <textarea id="questionText" class="form-control" rows="5" placeholder="Enter your question here" required></textarea>
            </div>
            <div class="form-group">
                <label for="codeSnippet">Code Snippet</label>
                <textarea id="codeSnippet" class="form-control" rows="5" placeholder="Enter your code snippet (if any)"></textarea>
            </div>
            <div class="form-group">
                <label for="category">Category <span class="text-danger">*</span></label>
                <div class="category-group">
                    <select id="category" class="form-control" required>
                        <option value="">Select a category</option>
                    </select>
                    <label for="newCategory">OR</label>

                    <input type="text" id="newCategory" class="form-control" placeholder="Category Not found? Enter new Category">
                    <button type="button" class="btn btn-secondary" onclick="QuestionController.AddCategory()">Add Category</button>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Post Question</button>
        </form>
    </div>
    @* <script>
        $(document).ready(function() {
            QuestionController.LoadCategories();
        });
    </script> *@
</body>
</html>
