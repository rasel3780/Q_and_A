
<div class="container">
    <h4 class="text-center">Post a New Question</h4>
    <div class="row">
        
        <div class="col-12" style="border:solid; border-color:lightgrey; border-radius:15px; background-color:white ">

            <form id="postQuestionForm" style="padding:5px">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" class="form-control" id="title" placeholder="Be specific.
" required>
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <input type="text" class="form-control" id="category" placeholder="e.g. C#, JS, PYTHON, etc.." required>
                </div>
                <div class="mb-3">
                    <label for="questionText" class="form-label">Question</label>
                    <textarea class="form-control" id="questionText" rows="3" placeholder="Enter the details of your question." required></textarea>
                </div>
                <div class="mb-3">
                    <label for="codeSnippet" class="form-label">Code Snippet</label>
                    <textarea class="form-control" id="codeSnippet" rows="3" placeholder="Paste code snippet if any."></textarea>
                </div>
                <div class="mb-3">
                <button class="btn btn-primary" type="submit">Post Question</button>
                </div>
            </form>
           
        </div>
    </div>
</div>