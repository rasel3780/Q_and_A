@{
    ViewData["Title"] = "Question Details";
    int questionID = ViewBag.quesID;
}

<div class="container">
    <div class="row" id="questionDetail">
        
    </div>
    <hr>
    
    <div class="answerContainer">

    </div>
   
    <div class="container">
        <div class="row" id="answerFormContainer">
            <div class="col-12">
                <form id="answerForm">
                    <h3>Post Your Answer</h3>
                    
                    <input type="hidden" id="QuestionID" name="QuestionID" value="@questionID" />
                    <div class="mb-3">
                        <label for="AnswerText">Enter Your Answer:</label>
                        <textarea id="AnswerText" name="AnswerText" required></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label for="CodeSnippet">Code snippet</label>
                        <textarea id="CodeSnippet" name="CodeSnippet" placeholder="Paste code snippet if any"></textarea>
                    </div>
                    
                    <button type="submit">Post Answer</button>
                </form>
            </div>
        </div>
        <div id="loginToAnswer">
            <p>Please <a class="text-primary" style="cursor: pointer;" onclick="window.location.href='@Url.Action("Login", "User")'">login</a> to submit an answer.</p>
        </div>
    </div>
</div>

@section Scripts {
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.5.1/highlight.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.5.1/styles/default.min.css">
    <script>
        $(document).ready(function () {
            QuestionController.LoadQuestionDetail(@questionID);
            const userID = localStorage.getItem('userID');
            if (userID) {
                $('#answerFormContainer').show();
                $('#loginToAnswer').hide();
            } else {
                $('#answerFormContainer').hide();
                $('#loginToAnswer').show();
            }
            $('#answerForm').on('submit', function (event) {
                event.preventDefault();
                AnswerController.PostAnswer();
            });

        });
    </script>
}
