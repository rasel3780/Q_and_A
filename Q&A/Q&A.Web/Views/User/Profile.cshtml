@{
    ViewData["Title"] = "Profile";
}

<h1>Profile</h1>



<div class="row mb-3">
    <div class="questionListContainer col-12" style="border:solid; border-color:lightgrey; border-radius:10px; background-color:white; padding:10px">
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody id="questionList">
           
            </tbody>
        </table>
    </div>
</div>



@section Scripts {
    <script>    
        $(document).ready(function () {
            var userId = localStorage.getItem('userID');
            UserController.GetQuestionListByUser(userId);
        });
    </script>
}