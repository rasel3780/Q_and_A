@{
    var redirectTo = Context.Request.Query["redirectTo"].ToString();
}

<style>
    .form-outline {
        text-align: left;
    }

    .form-label {
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .error {
        color: red;
        font-size: 0.8em;
        margin-top: 5px;
    }
</style>

@if (redirectTo == "askQuestion")
{
    <div class="card mb-4">
        <div class="card-body text-center">
            <h5 class="card-title">You must be logged in to ask a question</h5>
            <p class="card-text">Log in below or sign up</p>
        </div>
    </div>
}
<div class="card from-card">
    <form id="loginForm">
        <div class="card-body p-5 text-center">
            <h3 class="mb-5">Sign in</h3>
            <div data-mdb-input-init class="form-outline mb-4">
                <label for="userName" class="form-label">Username</label>
                <input type="text" id="userName" name="userName" placeholder="Enter your username" class="form-control form-control-lg" required />
            </div>
            <div data-mdb-input-init class="form-outline mb-4">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter your password" class="form-control form-control-lg" required />
            </div>
            <div class="form-check d-flex align-items-center mb-4">
                <input class="form-check-input custom-checkbox" type="checkbox" id="showPass" />
                <label class="form-check-label custom-label ms-2" for="showPass">Show password</label>
            </div>
            <button class="form-btn btn-primary" type="submit">Login</button>
            <hr class="my-4">
            <button class="form-btn btn-primary" style="background-color: #dd4b39;" onclick="window.location.href='@Url.Action("Registration","User")'">Register</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#loginForm').validate({
                rules: {
                    userName: {
                        required: true,
                        minlength: 3
                    },
                    password: {
                        required: true,
                        minlength: 6
                    }
                },
                messages: {
                    userName: {
                        required: "Please enter your username",
                        minlength: "Username must be at least 3 characters long"
                    },
                    password: {
                        required: "Please enter your password",
                        minlength: "Password must be at least 6 characters long"
                    }
                },
                errorElement: 'span',
                errorPlacement: function (error, element) {
                    error.addClass('error');
                    error.insertAfter(element);
                },
                submitHandler: function (form) {
                    UserController.GetUser();
                }
            });

            $('#showPass').on('change', function () {
                var passwordInput = $('#password');
                passwordInput.attr('type', this.checked ? 'text' : 'password');
            });

            $('#loginForm').on('submit', function (event) {
                event.preventDefault();
                UserController.GetUser(function (success) {
                    if (success) {
                        var urlParams = new URLSearchParams(window.location.search);
                        var redirectTo = urlParams.get('redirectTo');
                        var questionID = urlParams.get('questionID');
                        if (redirectTo === 'questionDetail' && questionID) {
                            window.location.href = '/Question/Detail/' + questionID;
                        } else {
                            window.location.href = '/';
                        }
                    }
                });
            });
        });
    </script>
}